# ── 后端 LLM（报告生成、简历解析、追问对话）──
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1

# ── 爬虫 Agent LLM（爬虫代码生成）──
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ── Docker 沙箱 ──
# SANDBOX_IMAGE=crawler-sandbox

# ══════════════════════════════════════════════════════════════════
# Agent 框架（移植自 fastapi-langgraph-agent 模板）
# 业务数据仍在 SQLite；下面这个 Postgres 只服务于 Agent 框架：
# LangGraph checkpoint（有状态会话）/ mem0 长期记忆 / JWT 鉴权表
# 启动：docker compose up -d agent-db
# ══════════════════════════════════════════════════════════════════

APP_ENV=development

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=job_matcher_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Agent 使用的模型（走 LLM_BASE_URL / LLM_API_KEY 这套 OpenAI 兼容配置）
DEFAULT_LLM_MODEL=deepseek-chat
DEFAULT_LLM_TEMPERATURE=0.2
MAX_TOKENS=8000

# 长期记忆（mem0 + pgvector）。需要 embedding 能力，若 LLM_BASE_URL 不支持
# embeddings，把 LONG_TERM_MEMORY_ENABLED 设为 false 即可整体关闭。
LONG_TERM_MEMORY_ENABLED=false
LONG_TERM_MEMORY_MODEL=deepseek-chat
LONG_TERM_MEMORY_EMBEDDER_MODEL=text-embedding-3-small

# 可观测性（Langfuse）
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# 鉴权。AUTH_ENABLED=true 才会挂载 /api/v1/auth 路由，
# 现有 /api/* 业务接口始终不受影响。
AUTH_ENABLED=false
JWT_SECRET_KEY=changeme-in-production

# 可选：Valkey/Redis 缓存 + 分布式限流。留空则用进程内实现。
# VALKEY_HOST=localhost
