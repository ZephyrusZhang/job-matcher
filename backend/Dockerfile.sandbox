FROM python:3.11-slim

# 替换 apt 源为阿里云镜像
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources

# Python 依赖。系统依赖交给 `--with-deps` 而不是手写清单：原来那份漏了
# libxfixes3，于是每个用 Playwright 的缓存脚本都会在 chromium.launch() 挂掉。
# 这个故障长期没被发现，因为 Agent 有沙箱 shell，撞到报错会自己 apt 装上再
# 继续 —— 修好的只是那个一次性容器，镜像照旧。让 Playwright 自己维护清单，
# 以后升级版本也不会再漂。
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple httpx playwright \
    && playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*

# 工作目录
RUN mkdir -p /home/user
WORKDIR /home/user

CMD ["sleep", "infinity"]
