# LLM API (used by backend for reports, resume parsing, crawler agent)
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Sandbox image name (must be built first)
SANDBOX_IMAGE=crawler-sandbox

# Agent framework store (LangGraph checkpoints + mem0 memory + auth tables).
# Business data stays in SQLite — this Postgres only backs the agent framework.
POSTGRES_DB=job_matcher_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
JWT_SECRET_KEY=changeme-in-production

# Observability (Langfuse) — optional
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Frontend API URL (as seen from the browser)
# For local deployment: http://localhost:8000
# For remote server: http://<your-server-ip>:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
